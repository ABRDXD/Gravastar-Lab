{
  "schema_version": 1,
  "preset_id": "toy-c3-new-shell-v1",
  "source": "https://arxiv.org/html/2309.00551v2",
  "reproduction": "Published equations; new shell radii, not figure reproduction",
  "parameters": {"mass": 1.0, "spin": 0.875, "lambda": 0.5, "r_in": 1.8, "r_out": 2.2},
  "domain": {"r_min": 0.2, "r_max": 12.0, "theta_min": 0.05, "theta_max": 3.091592653589793},
  "sampling": {"radial_intervals_per_region": 80, "angular_intervals": 24},
  "decimal_precision": 60,
  "reference_step": "0.000001",
  "convergence_steps": ["0.004", "0.002", "0.001", "0.0005"],
  "thresholds": {
    "metric_scaled": 5e-12, "inverse_scaled": 5e-11,
    "first_scaled": 2e-9, "second_scaled": 2e-8,
    "curvature_scaled": 2e-7, "exact_curvature_scaled": 2e-9,
    "matching_through_third_scaled": 2e-8,
    "extrinsic_matching_scaled": 2e-10,
    "inverse_identity_abs": 2e-11,
    "constant_curvature_tensor_scaled": 2e-8,
    "min_eigenvalue_abs": 1e-6,
    "max_condition_number": 1e8,
    "convergence_min_ratio": 3.0
  }
}
