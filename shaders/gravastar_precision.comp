// SPDX-License-Identifier: GPL-3.0-or-later
// Phase D precision study kernel: fixed-step RK4 on the closed-form
// stereographic Hamiltonian, one ray per invocation. Builds:
//   default            state and Hamiltonian in float
//   -DGRAVASTAR_FP64   both in double
//   -DGRAVASTAR_MIXED  state and RK4 sums in double, Hamiltonian in float
// Not a renderer: no events beyond the radial stops and the patch switch.
//
// Input (STATE[]): header[16] = M, a, Lambda, r_in, r_out, h, steps, r_outer,
// r_inner, switch_q, 0...; then 8 REALs per ray (north patch).
// Output (STATE[]): 16 per ray = state[8], patch (0 north, 1 south),
// status (0 budget, 1 outer, 2 inner, 3 invalid), steps, switches, H, 0, 0, 0.
#version 460
#extension GL_GOOGLE_include_directive : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "gravastar_stereographic.glsl"

#if defined(GRAVASTAR_FP64) || defined(GRAVASTAR_MIXED)
#define STATE double
#else
#define STATE float
#endif

layout(std430, set = 0, binding = 0) readonly buffer Inputs { STATE v[]; } inp;
layout(std430, set = 0, binding = 1) writeonly buffer Outputs { STATE v[]; } outp;

// Hamiltonian evaluation at the RHS precision, from a state-precision point.
bool rhs(StereoModel m, STATE y[8], out STATE d[8], out STATE H) {
    REAL z[8], e[8];
    REAL h;
    for (int i = 0; i < 8; ++i) z[i] = REAL(y[i]);
    bool ok = stereographic_rhs(m, z, e, h);
    for (int i = 0; i < 8; ++i) d[i] = STATE(e[i]);
    H = STATE(h);
    return ok;
}
void switch_state(inout STATE y[8]) {
    STATE q = y[2] * y[2] + y[3] * y[3];
    STATE R = y[2] * y[6] + y[3] * y[7];
    STATE x = y[2], v = y[3];
    y[2] = x / q;
    y[3] = v / q;
    y[6] = q * y[6] - STATE(2) * x * R;
    y[7] = q * y[7] - STATE(2) * v * R;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint rays = (uint(inp.v.length()) - 16u) / 8u;
    if (id >= rays)
        return;
    StereoModel m;
    m.M = REAL(inp.v[0]);
    m.a = REAL(inp.v[1]);
    m.Lambda = REAL(inp.v[2]);
    m.r_in = REAL(inp.v[3]);
    m.r_out = REAL(inp.v[4]);
    STATE h = inp.v[5];
    uint steps = uint(inp.v[6]);
    STATE r_outer = inp.v[7], r_inner = inp.v[8], switch_q = inp.v[9];

    STATE y[8];
    for (int i = 0; i < 8; ++i)
        y[i] = inp.v[16u + 8u * id + uint(i)];
    uint chart = 0u, status = 0u, done = 0u, switches = 0u;
    STATE H = STATE(0);
    for (uint n = 0u; n < steps; ++n) {
        STATE k1[8], k2[8], k3[8], k4[8], z[8];
        STATE Hs;
        if (!rhs(m, y, k1, Hs)) { status = 3u; break; }
        for (int i = 0; i < 8; ++i) z[i] = y[i] + h * STATE(0.5) * k1[i];
        if (!rhs(m, z, k2, Hs)) { status = 3u; break; }
        for (int i = 0; i < 8; ++i) z[i] = y[i] + h * STATE(0.5) * k2[i];
        if (!rhs(m, z, k3, Hs)) { status = 3u; break; }
        for (int i = 0; i < 8; ++i) z[i] = y[i] + h * k3[i];
        if (!rhs(m, z, k4, Hs)) { status = 3u; break; }
        for (int i = 0; i < 8; ++i)
            y[i] += h * (k1[i] + STATE(2) * k2[i] + STATE(2) * k3[i] + k4[i]) / STATE(6);
        done = n + 1u;
        if (y[1] >= r_outer) { status = 1u; break; }
        if (y[1] <= r_inner) { status = 2u; break; }
        if (y[2] * y[2] + y[3] * y[3] >= switch_q) {
            switch_state(y);
            chart ^= 1u;
            ++switches;
        }
    }
    STATE d[8];
    if (status != 3u && !rhs(m, y, d, H))
        status = 3u;
    uint base = 16u * id;
    for (int i = 0; i < 8; ++i)
        outp.v[base + uint(i)] = y[i];
    outp.v[base + 8u] = STATE(chart);
    outp.v[base + 9u] = STATE(status);
    outp.v[base + 10u] = STATE(done);
    outp.v[base + 11u] = STATE(switches);
    outp.v[base + 12u] = H;
    outp.v[base + 13u] = STATE(0);
    outp.v[base + 14u] = STATE(0);
    outp.v[base + 15u] = STATE(0);
}
