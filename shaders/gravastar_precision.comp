// SPDX-License-Identifier: GPL-3.0-or-later
// Phase D precision study kernel: fixed-step RK4 on the closed-form
// stereographic Hamiltonian, one ray per invocation, built as FP32 and FP64.
// Not a renderer: no events beyond the radial stops and the patch switch.
//
// Input (REAL[]): header[16] = M, a, Lambda, r_in, r_out, h, steps, r_outer,
// r_inner, switch_q, 0...; then 8 REALs per ray (north patch).
// Output (REAL[]): 16 per ray = state[8], patch (0 north, 1 south),
// status (0 budget, 1 outer, 2 inner, 3 invalid), steps, switches, H, 0, 0, 0.
#version 460
#extension GL_GOOGLE_include_directive : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "gravastar_stereographic.glsl"

layout(std430, set = 0, binding = 0) readonly buffer Inputs { REAL v[]; } inp;
layout(std430, set = 0, binding = 1) writeonly buffer Outputs { REAL v[]; } outp;

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint rays = (uint(inp.v.length()) - 16u) / 8u;
    if (id >= rays)
        return;
    StereoModel m;
    m.M = inp.v[0];
    m.a = inp.v[1];
    m.Lambda = inp.v[2];
    m.r_in = inp.v[3];
    m.r_out = inp.v[4];
    REAL h = inp.v[5];
    uint steps = uint(inp.v[6]);
    REAL r_outer = inp.v[7], r_inner = inp.v[8], switch_q = inp.v[9];

    REAL y[8];
    for (int i = 0; i < 8; ++i)
        y[i] = inp.v[16u + 8u * id + uint(i)];
    uint chart = 0u, status = 0u, done = 0u, switches = 0u;
    REAL H = REAL(0);
    for (uint n = 0u; n < steps; ++n) {
        REAL k1[8], k2[8], k3[8], k4[8], z[8];
        REAL Hs;
        if (!stereographic_rhs(m, y, k1, Hs)) { status = 3u; break; }
        for (int i = 0; i < 8; ++i) z[i] = y[i] + h * REAL(0.5) * k1[i];
        if (!stereographic_rhs(m, z, k2, Hs)) { status = 3u; break; }
        for (int i = 0; i < 8; ++i) z[i] = y[i] + h * REAL(0.5) * k2[i];
        if (!stereographic_rhs(m, z, k3, Hs)) { status = 3u; break; }
        for (int i = 0; i < 8; ++i) z[i] = y[i] + h * k3[i];
        if (!stereographic_rhs(m, z, k4, Hs)) { status = 3u; break; }
        for (int i = 0; i < 8; ++i)
            y[i] += h * (k1[i] + REAL(2) * k2[i] + REAL(2) * k3[i] + k4[i]) / REAL(6);
        done = n + 1u;
        if (y[1] >= r_outer) { status = 1u; break; }
        if (y[1] <= r_inner) { status = 2u; break; }
        if (y[2] * y[2] + y[3] * y[3] >= switch_q) {
            switch_patch(y);
            chart ^= 1u;
            ++switches;
        }
    }
    REAL d[8];
    if (status != 3u && !stereographic_rhs(m, y, d, H))
        status = 3u;
    uint base = 16u * id;
    for (int i = 0; i < 8; ++i)
        outp.v[base + uint(i)] = y[i];
    outp.v[base + 8u] = REAL(chart);
    outp.v[base + 9u] = REAL(status);
    outp.v[base + 10u] = REAL(done);
    outp.v[base + 11u] = REAL(switches);
    outp.v[base + 12u] = H;
    outp.v[base + 13u] = REAL(0);
    outp.v[base + 14u] = REAL(0);
    outp.v[base + 15u] = REAL(0);
}
