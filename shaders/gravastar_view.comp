#version 460
// Studio view: shows a traced image (RGBA8 packed in a buffer) scaled to fit
// the window, aspect preserved, nearest-pixel. Display only: the colours are
// the diagnostic mapping of linear data, not the data itself.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D target_image;
layout(std430, set = 0, binding = 1) readonly buffer Source { uint pixels[]; } source;
// packed = source width << 16 | source height (0 when there is no image yet)
layout(push_constant) uniform Parameters { uint width; uint height; uint phase; uint packed; } p;

void main() {
    uvec2 xy = gl_GlobalInvocationID.xy;
    if (xy.x >= p.width || xy.y >= p.height)
        return;
    vec4 colour = vec4(12.0, 12.0, 16.0, 255.0) / 255.0;
    uint sw = p.packed >> 16u, sh = p.packed & 0xffffu;
    if (sw > 0u && sh > 0u) {
        float scale = min(float(p.width) / float(sw), float(p.height) / float(sh));
        vec2 offset = 0.5 * (vec2(p.width, p.height) - scale * vec2(sw, sh));
        vec2 uv = (vec2(xy) + 0.5 - offset) / scale;
        if (uv.x >= 0.0 && uv.y >= 0.0 && uv.x < float(sw) && uv.y < float(sh)) {
            uint v = source.pixels[uint(uv.y) * sw + uint(uv.x)];
            colour = vec4(float(v & 255u), float((v >> 8u) & 255u), float((v >> 16u) & 255u),
                          255.0) / 255.0;
        }
    }
    imageStore(target_image, ivec2(xy), colour);
}
