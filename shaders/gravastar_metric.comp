#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct InputRecord {
    vec4 coords;        // r, theta, phi, unused
    vec4 params_geom;   // M, a, Lambda, unused
    vec4 params_radii;  // r_in, r_out, family, unused
};

struct OutputRecord {
    uvec4 status;       // ok=1/err=0, id, reserved...
    vec4 scalars;       // mu, lambda, delta, sigma
    float metric[16];   // g_mu_nu (4x4)
    float inverse[16];  // g^{mu nu} (4x4)
    float dg_dr[16];    // partial_r g_mu_nu
    float dg_dth[16];   // partial_theta g_mu_nu
};

layout(std430, set = 0, binding = 0) readonly buffer Inputs {
    InputRecord records[];
} inputs;

layout(std430, set = 0, binding = 1) writeonly buffer Outputs {
    OutputRecord records[];
} outputs;

float smoothstep_c3(float u) {
    float u2 = u * u;
    return u2 * u2 * (35.0 + u * (-84.0 + u * (70.0 - 20.0 * u)));
}

float dsmoothstep_c3(float u) {
    float u3 = u * u * u;
    return u3 * (140.0 + u * (-420.0 + u * (420.0 - 140.0 * u)));
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    InputRecord in_rec = inputs.records[id];

    float r = in_rec.coords.x;
    float theta = in_rec.coords.y;
    float M = in_rec.params_geom.x;
    float a = in_rec.params_geom.y;
    float Lambda = in_rec.params_geom.z;
    float r_in = in_rec.params_radii.x;
    float r_out = in_rec.params_radii.y;

    OutputRecord out_rec;
    out_rec.status = uvec4(1, id, 0, 0);

    if (r <= 0.0 || theta <= 0.0 || theta >= 3.141592653589793) {
        out_rec.status.x = 0; // Error
        outputs.records[id] = out_rec;
        return;
    }

    float width = r_out - r_in;
    float mu = 0.0;
    float lam = 0.0;
    float dmu_dr = 0.0;
    float dlam_dr = 0.0;

    if (r <= r_in) {
        mu = 0.0; lam = 1.0;
    } else if (r >= r_out) {
        mu = 1.0; lam = 0.0;
    } else {
        if (r - r_in <= width * 0.5) {
            float u = (r - r_in) / width;
            mu = smoothstep_c3(u);
            lam = 1.0 - mu;
            dmu_dr = dsmoothstep_c3(u) / width;
            dlam_dr = -dmu_dr;
        } else {
            float u = (r_out - r) / width;
            lam = smoothstep_c3(u);
            mu = 1.0 - lam;
            dlam_dr = -dsmoothstep_c3(u) / width;
            dmu_dr = -dlam_dr;
        }
    }

    float eff_lam = Lambda * lam;
    float deff_lam_dr = Lambda * dlam_dr;

    float r2 = r * r;
    float a2 = a * a;
    float s = sin(theta);
    float c = cos(theta);
    float s2 = s * s;
    float c2 = c * c;
    float A = r2 + a2;
    float sigma = r2 + a2 * c2;
    float delta = A * (1.0 - eff_lam * r2 / 3.0) - 2.0 * M * mu * r;
    float T = 1.0 + eff_lam * a2 * c2 / 3.0;
    float X = 1.0 + eff_lam * a2 / 3.0;

    out_rec.scalars = vec4(mu, lam, delta, sigma);

    float denom = sigma * X * X;

    // Metric components
    float g00 = (T * a2 * s2 - delta) / denom;
    float g03 = a * s2 * (delta - T * A) / denom;
    float g33 = s2 * (T * A * A - delta * a2 * s2) / denom;
    float g11 = sigma / delta;
    float g22 = sigma / T;

    for (int i = 0; i < 16; ++i) {
        out_rec.metric[i] = 0.0;
        out_rec.inverse[i] = 0.0;
        out_rec.dg_dr[i] = 0.0;
        out_rec.dg_dth[i] = 0.0;
    }

    out_rec.metric[0]  = g00;
    out_rec.metric[3]  = g03;
    out_rec.metric[12] = g03;
    out_rec.metric[15] = g33;
    out_rec.metric[5]  = g11;
    out_rec.metric[10] = g22;

    // Inverse metric
    float pref = (X * X) / sigma;
    out_rec.inverse[0]  = -pref * (A * A / delta - a2 * s2 / T);
    out_rec.inverse[3]  = -a * pref * (A / delta - 1.0 / T);
    out_rec.inverse[12] = out_rec.inverse[3];
    out_rec.inverse[15] = pref * (1.0 / (T * s2) - a2 / delta);
    out_rec.inverse[5]  = delta / sigma;
    out_rec.inverse[10] = T / sigma;

    // Derivatives with respect to r
    float dsigma_dr = 2.0 * r;
    float dA_dr = 2.0 * r;
    float ddelta_dr = dA_dr * (1.0 - eff_lam * r2 / 3.0)
                    + A * (-deff_lam_dr * r2 / 3.0 - eff_lam * 2.0 * r / 3.0)
                    - 2.0 * M * (dmu_dr * r + mu);
    float dT_dr = deff_lam_dr * a2 * c2 / 3.0;
    float dX_dr = deff_lam_dr * a2 / 3.0;
    float ddenom_dr = dsigma_dr * X * X + sigma * 2.0 * X * dX_dr;

    float dg00_dr = ((dT_dr * a2 * s2 - ddelta_dr) * denom - (T * a2 * s2 - delta) * ddenom_dr) / (denom * denom);
    float dg03_dr = a * s2 * ((ddelta_dr - dT_dr * A - T * dA_dr) * denom - (delta - T * A) * ddenom_dr) / (denom * denom);
    float dg33_dr = s2 * ((dT_dr * A * A + T * 2.0 * A * dA_dr - ddelta_dr * a2 * s2) * denom - (T * A * A - delta * a2 * s2) * ddenom_dr) / (denom * denom);

    out_rec.dg_dr[0]  = dg00_dr;
    out_rec.dg_dr[3]  = dg03_dr;
    out_rec.dg_dr[12] = dg03_dr;
    out_rec.dg_dr[15] = dg33_dr;

    outputs.records[id] = out_rec;
}
